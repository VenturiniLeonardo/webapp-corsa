ALLOWED_LOGINS=your_tailscale_username
DATABASE_URL=sqlite:////data/corsa.db
ENV=dev
AUTH_DEV_LOGIN=dev_user

# AI analysis via OpenRouter (optional; empty = disabled). Never commit a real key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# intervals.icu pull (optional; empty = disabled). Key from intervals.icu Settings > Developer.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0
